<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="18px"><strong>Reset your password</strong></mj-text>
        <mj-text>Click the button below to set a new password.</mj-text>
        {{> button link=link label="Reset password" }}
        <mj-text>If the button doesn't work, copy and paste this URL:</mj-text>
        <mj-text color="#374151"><code>{{link}}</code></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
