<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#111827" />
      <mj-button
        background-color="#111827"
        color="#ffffff"
        border-radius="8px"
      />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F3F4F6">
    <mj-section padding="32px 0">
      <mj-column>
        <mj-text font-size="20px" align="center"
          ><strong>Your App</strong></mj-text
        >
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="12px" padding="24px">
      <mj-column> {{{body}}} </mj-column>
    </mj-section>

    <mj-section padding="24px 0 48px 0">
      <mj-column> {{> footer }} </mj-column>
    </mj-section>
  </mj-body>
</mjml>
